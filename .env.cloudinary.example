# Cloudinary Configuration
# Sign up at https://cloudinary.com (Free plan: 25GB storage, 25GB bandwidth/month)

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Note: 
# - NEXT_PUBLIC_ prefix means it's exposed to the browser (safe for API key)
# - CLOUDINARY_API_SECRET should NEVER have NEXT_PUBLIC_ prefix (keep secret)
